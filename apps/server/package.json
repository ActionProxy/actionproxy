{
  "name": "@actionproxy/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "benchmark:content-influence": "node --import tsx src/benchmarks/content-influence.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts --no-file-parallelism"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.21.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
