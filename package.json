{
  "name": "actionproxy",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open-source approval gateway for AI agent tool calls",
  "repository": {
    "type": "git",
    "url": "https://github.com/ActionProxy/actionproxy.git"
  },
  "homepage": "https://github.com/ActionProxy/actionproxy#readme",
  "bugs": {
    "url": "https://github.com/ActionProxy/actionproxy/issues"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "benchmark:content-influence": "corepack pnpm --filter @actionproxy/server benchmark:content-influence",
    "build": "corepack pnpm -r build",
    "demo:chatgpt": "corepack pnpm --filter @actionproxy/server build && node examples/chatgpt-app/run-local-protocol-smoke.mjs",
    "demo:chatgpt:tunnel": "ACTIONPROXY_PNPM_ENTRY=1 ./actionproxy chatgpt",
    "demo:gmail-mcp": "corepack pnpm --filter @actionproxy/mcp-wrapper build && node examples/google-workspace-mcp-demo/run-gmail-draft-test.mjs",
    "demo:mcp": "corepack pnpm --filter @actionproxy/mcp-wrapper build && node examples/mcp-demo/run-smoke-test.mjs",
    "demo:mcp:hosts": "corepack pnpm --filter @actionproxy/mcp-wrapper build && node examples/mcp-hosts/print-host-configs.mjs",
    "demo:mcp:manual": "corepack pnpm --filter @actionproxy/mcp-wrapper build && node examples/mcp-demo/run-smoke-test.mjs --manual-approval",
    "quickstart": "ACTIONPROXY_PNPM_ENTRY=1 ./actionproxy",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "schemas:generate": "node scripts/generate-config-schemas.mjs",
    "schemas:check": "node scripts/generate-config-schemas.mjs --check",
    "contracts:validate": "node scripts/validate-contract-artifacts.mjs",
    "release:versions:check": "node scripts/check-release-versions.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:proxy:gmail-mcp": "node scripts/dev.mjs --server-only --google-workspace-demo",
    "dev:web:gmail-mcp": "node scripts/dev.mjs --web-only --google-workspace-demo",
    "dev:proxy": "node scripts/dev.mjs --server-only --proxy",
    "dev:server": "node scripts/dev.mjs --server-only",
    "dev:web": "node scripts/dev.mjs --web-only",
    "docker:build": "docker build -t actionproxy:local .",
    "docker:smoke:community": "node scripts/smoke-community-docker.mjs",
    "lint": "corepack pnpm -r lint",
    "manifest:refresh": "node scripts/refresh-public-manifest.mjs .",
    "smoke:mcp-package": "node scripts/smoke-packaged-mcp-wrapper.mjs",
    "supply-chain:audit": "node scripts/check-dependency-audit.mjs",
    "supply-chain:licenses": "node scripts/check-runtime-licenses.mjs",
    "supply-chain:sbom": "corepack pnpm --filter @actionproxy/server --filter @actionproxy/mcp-wrapper sbom --prod --sbom-format cyclonedx --out bom.json && node scripts/validate-sbom.mjs bom.json",
    "test": "corepack pnpm test:first-run && corepack pnpm test:openapi && corepack pnpm test:schemas && corepack pnpm test:contract-validation && corepack pnpm test:release-versions && corepack pnpm test:dev && corepack pnpm test:supply-chain && corepack pnpm -r --workspace-concurrency=1 test && corepack pnpm test:mcp-hosts",
    "test:dev": "node --test scripts/dev.test.mjs",
    "test:first-run": "node --test scripts/first-run.test.mjs examples/chatgpt-tunnel/run-tunnel.test.mjs",
    "test:openapi": "node --test scripts/generate-openapi.test.mjs",
    "test:schemas": "node --test scripts/generate-config-schemas.test.mjs",
    "test:contract-validation": "node --test scripts/validate-contract-artifacts.test.mjs",
    "test:release-versions": "node --test scripts/check-release-versions.test.mjs",
    "test:consumer-conformance": "corepack pnpm --filter @actionproxy/mcp-wrapper exec vitest run src/package-artifacts.test.ts",
    "test:e2e": "corepack pnpm --filter @actionproxy/web test:e2e:community",
    "test:e2e:community": "corepack pnpm --filter @actionproxy/web test:e2e:community",
    "test:mcp-hosts": "node --test examples/mcp-hosts/print-host-configs.test.mjs examples/chatgpt-app/example.test.mjs examples/chatgpt-tunnel/run-tunnel.test.mjs",
    "test:postgres:no-skip": "node scripts/run-postgres-release-tests.mjs",
    "test:supply-chain": "node --test scripts/supply-chain.test.mjs scripts/run-postgres-release-tests.test.mjs",
    "verify:oss-boundary": "node scripts/verify-public-export.mjs . --checkout --strict",
    "verify:tracked-checkout": "node scripts/attest-public-checkout.mjs .",
    "workflow:check": "node scripts/check-workflow-actions.mjs"
  },
  "devDependencies": {
    "@readme/openapi-parser": "6.3.0",
    "ajv": "8.20.0"
  }
}
