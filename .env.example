# Local server
# Copy to .env for local development. ActionProxy loads root .env at startup.
ACTIONPROXY_PORT=8787
ACTIONPROXY_HOST=127.0.0.1
ACTIONPROXY_ALLOW_UNSAFE_LOCAL_BIND=false
ACTIONPROXY_POLICY_PATH=apps/server/src/policies/default.policy.yaml
ACTIONPROXY_DATA_DIR=.actionproxy
ACTIONPROXY_APPROVER_DIRECTORY_PATH=.actionproxy/approver-directory.local.json
ACTIONPROXY_LOG_LEVEL=info
ACTIONPROXY_DEPLOYMENT_MODE=local
ACTIONPROXY_WEB_DIST_PATH=apps/web/dist
ACTIONPROXY_PUBLIC_BASE_URL=

# Local mock tools are for the deterministic demo. Use disabled when an
# external runner owns execution.
ACTIONPROXY_LOCAL_EXECUTION=mock

# Storage: memory, sqlite, or postgres.
ACTIONPROXY_STORAGE=memory
ACTIONPROXY_SQLITE_PATH=.actionproxy/actionproxy.sqlite
DATABASE_URL=postgres://actionproxy:actionproxy@127.0.0.1:54329/actionproxy

# Off by default. Enabling stdio discovery runs command/cwd/env values saved in
# MCP profiles, so enable it only for trusted local profiles.
ACTIONPROXY_MCP_STDIO_DISCOVERY_ENABLED=false

# Experimental OAuth-protected Streamable HTTP MCP resource at /mcp.
ACTIONPROXY_MCP_STREAMABLE_HTTP_ENABLED=false
ACTIONPROXY_MCP_RESOURCE_URL=
ACTIONPROXY_MCP_AUTHORIZATION_SERVER=
ACTIONPROXY_MCP_ALLOWED_ORIGINS=https://chatgpt.com
ACTIONPROXY_MCP_SESSION_SECRET=
ACTIONPROXY_MCP_SESSION_TTL_MS=1800000
ACTIONPROXY_MCP_REQUEST_TIMEOUT_MS=30000
ACTIONPROXY_MCP_MAX_RESPONSE_BYTES=262144

# Optional Slack approval delivery.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL_ID=

# Optional Telegram approval delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_APPROVAL_CHAT_ID=

# Optional email approval delivery. Outbox is a local demo; smtp is operated by
# the self-hoster. Supply passwords through the runtime secret manager.
ACTIONPROXY_EMAIL_TRANSPORT=outbox
ACTIONPROXY_EMAIL_FROM=
ACTIONPROXY_EMAIL_APPROVAL_RECIPIENT=
ACTIONPROXY_EMAIL_PUBLIC_BASE_URL=
ACTIONPROXY_EMAIL_SMTP_HOST=
ACTIONPROXY_EMAIL_SMTP_PORT=587
ACTIONPROXY_EMAIL_SMTP_SECURE=false
ACTIONPROXY_EMAIL_SMTP_USERNAME=
ACTIONPROXY_EMAIL_SMTP_PASSWORD=

# Authentication. none is for loopback demos. Use api_key or oidc_jwt for a
# self-hosted deployment reachable by other machines.
ACTIONPROXY_AUTH_MODE=none
ACTIONPROXY_WORKSPACE_ID=default
ACTIONPROXY_BOOTSTRAP_ADMIN_API_KEY=
ACTIONPROXY_CORS_ORIGINS=
ACTIONPROXY_RATE_LIMIT_MAX=600
ACTIONPROXY_RATE_LIMIT_WINDOW_MS=60000
ACTIONPROXY_OIDC_ISSUER=
ACTIONPROXY_OIDC_AUDIENCE=
ACTIONPROXY_OIDC_JWKS_JSON=
ACTIONPROXY_OIDC_JWKS_PATH=
ACTIONPROXY_OIDC_JWKS_URI=
ACTIONPROXY_OIDC_EMAIL_CLAIM=email
ACTIONPROXY_OIDC_NAME_CLAIM=name
ACTIONPROXY_OIDC_GROUPS_CLAIM=groups
ACTIONPROXY_OIDC_SCOPES_CLAIM=scope
ACTIONPROXY_SLACK_USER_MAP_JSON=

# External execution grants.
ACTIONPROXY_EXECUTION_GRANT_SECRET=
ACTIONPROXY_EXECUTION_GRANT_TTL_SECONDS=300

# Optional OpenTelemetry lifecycle telemetry. Raw payloads are not exported.
ACTIONPROXY_OTEL_ENABLED=false
ACTIONPROXY_OTEL_SERVICE_NAME=actionproxy
ACTIONPROXY_OTEL_EXPORTER_OTLP_ENDPOINT=
ACTIONPROXY_OTEL_EXPORTER_OTLP_HEADERS=
