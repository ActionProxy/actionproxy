# Copy this file to .env.local in the same directory.
# .env.local is ignored by git.
# This file is mandatory and overrides the matching ambient shell variables.

# ActionProxy
ACTIONPROXY_BASE_URL=http://127.0.0.1:8787
ACTIONPROXY_APPROVAL_URL=http://127.0.0.1:5173/#/approvals

# Google OAuth desktop client from Google Cloud Console.
# Enable the Gmail API in the same project before running the demo.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Use a test Gmail or Google Workspace account.
USER_GOOGLE_EMAIL=

# Optional synthetic demo inputs. GMAIL_DRAFT_TO defaults to USER_GOOGLE_EMAIL
# and must match it; the Community proof will not target another address.
GMAIL_DRAFT_TO=
GMAIL_DRAFT_SUBJECT=ActionProxy local Gmail MCP draft test
GMAIL_DRAFT_BODY=This draft was created only after ActionProxy approval.
GMAIL_SEARCH_QUERY=subject:"ActionProxy local Gmail MCP draft test" newer_than:1d

# The script fixes credentials, cache, attachments, logs, temporary files, and
# the OAuth callback host under .actionproxy/google-workspace-mcp with private
# permissions. Those paths are intentionally not configurable in this proof.
