# Community-only ChatGPT developer-mode MCP example.
# Copy this file to the repository root as .env.local and replace every example.

ACTIONPROXY_DEPLOYMENT_MODE=self_hosted
ACTIONPROXY_HOST=127.0.0.1
ACTIONPROXY_PORT=8787
ACTIONPROXY_STORAGE=sqlite
ACTIONPROXY_DATA_DIR=.actionproxy/chatgpt-demo
ACTIONPROXY_LOCAL_EXECUTION=mock

# Ordinary operator API authentication.
ACTIONPROXY_AUTH_MODE=oidc_jwt
ACTIONPROXY_OIDC_ISSUER=https://auth.example.com
ACTIONPROXY_OIDC_AUDIENCE=https://actionproxy.example.com/api
ACTIONPROXY_OIDC_JWKS_PATH=replace-with-absolute-path-to-reviewed-jwks.json

# Remove this value and restart after creating the first default approver.
ACTIONPROXY_BOOTSTRAP_ADMIN_API_KEY=replace-with-one-time-bootstrap-secret

# Standard OAuth-protected Streamable HTTP MCP resource.
ACTIONPROXY_MCP_STREAMABLE_HTTP_ENABLED=true
ACTIONPROXY_MCP_RESOURCE_URL=https://actionproxy.example.com/mcp
ACTIONPROXY_MCP_AUTHORIZATION_SERVER=https://auth.example.com
ACTIONPROXY_MCP_ALLOWED_ORIGINS=https://chatgpt.com
ACTIONPROXY_MCP_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Keep this independent from the MCP session secret.
ACTIONPROXY_EXECUTION_GRANT_SECRET=replace-with-another-random-secret
